# ============================================================
#  MailFlow — .gitignore
# ============================================================

# ─── Python / Django ─────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
venv/
env/
.venv/
ENV/

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
/backend/staticfiles/
/backend/media/
/backend/private_media/
/backend/logs/

# Environment files
.env

# Migrations (keep these in version control)
# Uncomment below only if you intentionally exclude migrations:
# */migrations/*.py
# !*/migrations/__init__.py

# ─── Node.js / Next.js ───────────────────────────────────────
node_modules/
.next/
out/
.cache/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/
*.tsbuildinfo
next-env.d.ts

# ─── OS & Editor ─────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# JetBrains IDEs
.idea/
*.iml

# VS Code (keep workspace settings if desired)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ─── Testing ─────────────────────────────────────────────────
.coverage
.coverage.*
htmlcov/
.pytest_cache/
coverage.xml
*.coveragerc
nosetests.xml

# ─── Build / Deploy ──────────────────────────────────────────
*.pid
*.seed
*.pid.lock

# Docker
.dockerignore

# Celery
celerybeat-schedule
celerybeat.pid

# ─── Secrets / Keys ──────────────────────────────────────────
*.pem
*.key
*.crt
*.p12
secrets.json
credentials.json
